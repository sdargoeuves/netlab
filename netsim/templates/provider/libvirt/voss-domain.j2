{# {% if n.mgmt is defined and n.mgmt.mac is defined %}
    {{ name }}.vm.provider :libvirt do |domain|
      {% set mac_parts = n.mgmt.mac.split(':') %}
      {% set last_octet = mac_parts[-1] | int(base=16) %}
      {% set new_octet = '%02x' | format(last_octet + 0x81) %}
      {% set new_mac = mac_parts[:-1] | join(':') + ':' + new_octet %}
      domain.management_network_mac = "{{ new_mac }}"
      domain.qemu_use_session = false
    end
{% endif %} #}

