    {{ name }}.vm.synced_folder ".", "/vagrant", id: "vagrant-root", disabled: true
    {{ name }}.ssh.insert_key = false
    {{ name }}.ssh.username = "rwa"
    {{ name }}.vm.boot_timeout = 300
    {{ name }}.vm.guest = :freebsd
    {{ name }}.ssh.shell = "show sys-info"


    {{ name }}.trigger.before :up do |trigger|
      trigger.info = "Adding temporary DHCP reservation... ip: {{ n.mgmt.ipv4 }} | mac: {{ n.mgmt.mac }}"
      trigger.run = {inline: "virsh net-update {{ addressing.mgmt._network }} add ip-dhcp-host \"<host id='01:ca:fe:00:01:00:00' ip='10.194.57.11'/>\" --live --config || true"}
    end

    {{ name }}.trigger.after :up do |trigger|
      trigger.info = "Cleaning up DHCP reservation... ip: {{ n.mgmt.ipv4 }} | mac: {{ n.mgmt.mac }}"
      trigger.run = {inline: "virsh net-update {{ addressing.mgmt._network }} delete ip-dhcp-host \"<host id='01:ca:fe:00:01:00:00' ip='10.194.57.11'/>\" --live --config || true"}
    end

